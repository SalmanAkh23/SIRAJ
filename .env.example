# Ahmad Sanusi Open API — kunci untuk halaman Doa & Dzikir SIRAJ
#
# Cara mendapatkan API Key (gratis):
#   1. Buka https://api.ahmadsanusi.com/register  → daftar akun (email + password).
#   2. Login, lalu buat API Key (lihat https://api.ahmadsanusi.com/docs, bagian Auth).
#   3. Salin key (hanya tampil SEKALI), lalu tempel di bawah.
#
# Salin file ini menjadi .env.local, lalu isi nilainya:
#   AHMAD_SANUSI_API_KEY=ask_xxxxxxxxxxxxxxxxxxxxxxxx
#
# Catatan:
#   - .env.local TIDAK ikut di-commit ke Git (sudah diatur di .gitignore).
#   - Jangan pernah menempelkan API Key ke dalam kode halaman React.
AHMAD_SANUSI_API_KEY=

# Base URL untuk API Hadits (opsional, default: https://hadis-api-id.vercel.app)
# Mendukung Hadis API ID (9 Kitab Kutubut Tis'ah) atau proxy HaditsSoft lokal
HADITH_API_BASE_URL=https://hadis-api-id.vercel.app
NEXT_PUBLIC_HADITH_API_URL=https://hadis-api-id.vercel.app

# ==============================================================================
# FITUR MURAJAAH HAFALAN AI (SPEECH-TO-TEXT BAHASA ARAB & EVALUASI SERVER)
# ==============================================================================
# Fitur Murajaah Hafalan AI secara default menggunakan Web Speech Recognition
# (bahasa Arab ar-SA) bawaan peramban secara otomatis dan tanpa biaya.
#
# Untuk pemrosesan audio server berkualitas tinggi (opsional):
# 1. GROQ_API_KEY: Groq Whisper Large v3 Turbo (direkomendasikan, sangat cepat)
#    Dapatkan di: https://console.groq.com/keys
# 2. OPENAI_API_KEY: OpenAI Whisper-1
#    Dapatkan di: https://platform.openai.com/api-keys
GROQ_API_KEY=
OPENAI_API_KEY=


